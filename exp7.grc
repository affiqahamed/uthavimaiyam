- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, example_param=1.0):\
      \  # only default arguments here\n        \"\"\"arguments to this function show\
      \ up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='Embedded Python Block',   # will show up in GRC\n\
      \            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n  \
      \      )\n        # if an attribute with the same name as a parameter is found,\n\
      \        # a callback is registered (properties work, too).\n        self.example_param\
      \ = example_param\n\n    def work(self, input_items, output_items):\n      \
      \  \"\"\"example: multiply with constant\"\"\"\n        output_items[0][:] =\
      \ input_items[0] * self.example_param\n        return len(output_items[0])\n\
      import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    ASK/OOK Decision Device\n\n    Input:\n        Complex matched-filter\
      \ samples\n\n    Output:\n        Detected bits (0 or 1)\n    \"\"\"\n\n   \
      \ def __init__(self, threshold=0.5):\n        gr.sync_block.__init__(\n    \
      \        self,\n            name=\"ASK Decision Device\",\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.uint8]\n        )\n\n        self.threshold = threshold\n\
      \n    def work(self, input_items, output_items):\n        # Complex samples\
      \ from matched filter/downsampler\n        y = input_items[0]\n\n        # Take\
      \ the in-phase (real) component\n        y_real = np.real(y)\n\n        # Decision:\n\
      \        # Real(y) > threshold -> 1\n        # Real(y) <= threshold -> 0\n \
      \       output_items[0][:] = (\n            y_real > self.threshold\n      \
      \  ).astype(np.uint8)\n\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold: '0.5'
  states:
    _io_cache: ('ASK Decision Device', 'blk', [('threshold', '0.5')], [('0', 'complex',
      1)], [('0', 'byte', 1)], '\n    ASK/OOK Decision Device\n\n    Input:\n        Complex
      matched-filter samples\n\n    Output:\n        Detected bits (0 or 1)\n    ',
      ['threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 416.0]
    rotation: 0
    state: true
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, example_param=1.0):\
      \  # only default arguments here\n        \"\"\"arguments to this function show\
      \ up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='Embedded Python Block',   # will show up in GRC\n\
      \            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n  \
      \      )\n        # if an attribute with the same name as a parameter is found,\n\
      \        # a callback is registered (properties work, too).\n        self.example_param\
      \ = example_param\n\n    def work(self, input_items, output_items):\n      \
      \  \"\"\"example: multiply with constant\"\"\"\n        output_items[0][:] =\
      \ input_items[0] * self.example_param\n        return len(output_items[0])\n\
      \nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    BER Calculator\n\n    Input 0 : Transmitted bits (uint8)\n\
      \    Input 1 : Detected bits    (uint8)\n\n    Output 0: BER\n    Output 1:\
      \ Total errors\n    Output 2: Total bits compared\n    \"\"\"\n\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='BER Calculator',\n\
      \            in_sig=[np.uint8, np.uint8],\n            out_sig=[np.float32,\
      \ np.float32, np.float32]\n        )\n\n        self.total_bits = 0\n      \
      \  self.total_errors = 0\n\n    def work(self, input_items, output_items):\n\
      \n        tx = input_items[0]\n        rx = input_items[1]\n\n        N = min(len(tx),\
      \ len(rx))\n\n        if N == 0:\n            return 0\n\n        # Count errors\
      \ in the current block\n        errors = np.count_nonzero(tx[:N] != rx[:N])\n\
      \n        # Cumulative counters\n        self.total_errors += int(errors)\n\
      \        self.total_bits += N\n\n        # Calculate BER\n        ber = float(self.total_errors)\
      \ / float(self.total_bits)\n\n        # Outputs\n        output_items[0][:N]\
      \ = ber\n        output_items[1][:N] = float(self.total_errors)\n        output_items[2][:N]\
      \ = float(self.total_bits)\n\n        return N\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''BER Calculator'', ''blk'', [], [(''0'', ''byte'', 1), (''1'', ''byte'',
      1)], [(''0'', ''float'', 1), (''1'', ''float'', 1), (''2'', ''float'', 1)],
      ''\n    BER Calculator\n\n    Input 0 : Transmitted bits (uint8)\n    Input
      1 : Detected bits    (uint8)\n\n    Output 0: BER\n    Output 1: Total errors\n    Output
      2: Total bits compared\n    '', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 248.0]
    rotation: 0
    state: true
