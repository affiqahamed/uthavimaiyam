- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    BER Calculator\n    Input 0 : Transmitted bits (uint8)\n  \
      \  Input 1 : Detected bits    (uint8)\n\n    Output 0: BER\n    Output 1: Total\
      \ errors\n    Output 2: Total bits compared\n    \"\"\"\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='BER Calculator',\n\
      \            in_sig=[np.uint8, np.uint8],\n            out_sig=[np.float32,\
      \ np.float32, np.float32]\n        )\n        self.total_bits = 0\n        self.total_errors\
      \ = 0\n\n    def work(self, input_items, output_items):\n        tx = input_items[0]\n\
      \        rx = input_items[1]\n        N = min(len(tx), len(rx))\n\n        if\
      \ N == 0:\n            return 0\n\n        # Accumulate stream comparisons\n\
      \        errors = np.count_nonzero(tx[:N] != rx[:N])\n        self.total_errors\
      \ += int(errors)\n        self.total_bits += N\n\n        ber = float(self.total_errors)\
      \ / float(self.total_bits) if self.total_bits > 0 else 0.0\n\n        output_items[0][:N]\
      \ = ber\n        output_items[1][:N] = float(self.total_errors)\n        output_items[2][:N]\
      \ = float(self.total_bits)\n\n        return N"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''BER Calculator'', ''blk'', [], [(''0'', ''byte'', 1), (''1'', ''byte'',
      1)], [(''0'', ''float'', 1), (''1'', ''float'', 1), (''2'', ''float'', 1)],
      ''\n    BER Calculator\n    Input 0 : Transmitted bits (uint8)\n    Input 1
      : Detected bits    (uint8)\n\n    Output 0: BER\n    Output 1: Total errors\n    Output
      2: Total bits compared\n    '', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [944, 520.0]
    rotation: 0
    state: true
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    ASK/OOK Decision Device\n    Input  : Complex matched-filter\
      \ samples\n    Output : Detected bits (0 or 1)\n    \"\"\"\n    def __init__(self,\
      \ threshold=0.0):\n        gr.sync_block.__init__(\n            self,\n    \
      \        name='ASK Decision Device',\n            in_sig=[np.complex64],\n \
      \           out_sig=[np.uint8]\n        )\n        self.threshold = threshold\n\
      \n    def work(self, input_items, output_items):\n        y = input_items[0]\n\
      \        # Real part comparison against optimal threshold\n        output_items[0][:]\
      \ = (np.real(y) > self.threshold).astype(np.uint8)\n        return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold: '0'
  states:
    _io_cache: '(''ASK Decision Device'', ''blk'', [(''threshold'', ''0.0'')], [(''0'',
      ''complex'', 1)], [(''0'', ''byte'', 1)], ''\n    ASK/OOK Decision Device\n    Input  :
      Complex matched-filter samples\n    Output : Detected bits (0 or 1)\n    '',
      [''threshold''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 656.0]
    rotation: 0
    state: true
